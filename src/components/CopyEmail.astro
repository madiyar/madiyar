---
const email = "hi@madiyar.dev";
---

<button
  class="glass ml-3 grid size-10 shrink-0 cursor-pointer place-items-center rounded-full text-zinc-300 hover:text-white"
  data-email={email}
  aria-label="Copy email"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2.5"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
</button>

<div
  class="glass toast fixed top-3 left-1/2 z-50 flex h-11 -translate-x-1/2 items-center gap-2 rounded-full px-4 text-sm font-medium"
  role="status"
  aria-live="polite"
  data-toast
>
  <span class="grid size-5 place-items-center rounded-full bg-emerald-500">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
  </span>
  Email copied
</div>

<script>
  const btn = document.querySelector<HTMLElement>('[data-email]');
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  let timer: ReturnType<typeof setTimeout>;

  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.email!);
    } catch {
      // no clipboard access: select the address so it can be copied by hand
      const heading = btn.previousElementSibling;
      if (heading) getSelection()?.selectAllChildren(heading);
      return;
    }

    toast?.classList.add('on');
    clearTimeout(timer);
    timer = setTimeout(() => toast?.classList.remove('on'), 1800);
  });
</script>
