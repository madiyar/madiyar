<div class="flex items-baseline gap-1">
  <span data-now></span>
  <span class="hidden text-zinc-400 text-[11px] sm:inline">GMT+5</span>
</div>

<script>
  import { almatyTime } from '@/shared/time';

  function updateTime() {
    const now = almatyTime();
    document.querySelectorAll('[data-now]').forEach(el => (el.textContent = now));
  }

  updateTime();
  setInterval(updateTime, 10_000);
</script>
