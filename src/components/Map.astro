---
import { Image } from 'astro:assets';

import map from '@/assets/map/map.webp';
import plane from '@/assets/map/plane.webp';
import planeShadow from '@/assets/map/plane-shadow.webp';
---

<a
  href="https://maps.apple.com/?q=Almaty"
  target="_blank"
  rel="noopener noreferrer"
  class="bubble them tail block w-72 p-0! transition-transform duration-300 hover:scale-[1.02]"
  data-msg="them-quick"
  aria-label="Almaty, Kazakhstan on Apple Maps"
>
  <div class="relative aspect-2/1 overflow-hidden rounded-t-[1.2rem]">
    <Image src={map} alt="" width={576} loading="eager" draggable={false} class="no-drag size-full object-cover" />

    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <Image src={planeShadow} alt="" width={48} class="absolute ml-5 mt-7 w-5 rotate-[51deg] animate-plane opacity-40" />
      <Image src={plane} alt="" width={48} class="absolute w-5 -translate-x-1/2 -translate-y-1/2 rotate-[51deg] animate-plane drop-shadow" />

      <span class="absolute left-[47%] top-[66%] size-4 -translate-1/2 animate-marker rounded-full bg-[#0a84ff]"></span>
      <span class="absolute left-[47%] top-[66%] size-4 -translate-1/2 rounded-full border-[3px] border-white bg-[#0a84ff] shadow-md"></span>
    </div>
  </div>

  <div class="flex flex-col px-3.5 py-2.5">
    <span class="text-[15px] font-semibold">Almaty, Kazakhstan</span>
    <span class="text-[13px] text-zinc-400">Shared location · <span data-now></span></span>
  </div>
</a>
