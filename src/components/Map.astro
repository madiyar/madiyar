---
---

<div
  class='relative h-fit w-fit animate-intro overflow-hidden opacity-0 [animation-delay:0.4s] rounded-3xl'
>
  <img
    src='/cloud.webp'
    width='390'
    height='347'
    alt=''
    draggable='false'
    class='absolute animate-cloud blur-sm'
  />
  <img
    src='/plane.webp'
    width='24'
    height='56'
    alt=''
    draggable='false'
    class='z-20 absolute -translate-x-0 animate-plane [animation-delay:5s]'
  />
  <img
    src='/plane-shadow.webp'
    width='24'
    height='24'
    alt=''
    draggable='false'
    class='z-20 absolute -translate-x-0 animate-plane-shadow [animation-delay:5s]'
  />
  <img
    width='500'
    height='250'
    src='/map.webp'
    alt='Map with marker east of Washington, DC'
    loading='eager'
    draggable='false'
    class='rounded-3xl'
  />

  <div
    class='exclude absolute bottom-0 right-0 mb-3 mr-3 select-none rounded-md border border-neutral-460 bg-neutral-50 px-2 py-1.5 text-xs text-neutral-600'
  >

    <div class="flex flex-col items-center gap-1">
      <span class="text-sm">09:50 PM</span>
      <span class="text-sm">Almaty, KZ</span>
    </div>

  </div>

  <div aria-hidden>
    <div
      class='absolute left-[52%] top-[46%] z-10 h-4 w-4 -translate-x-1/2 -translate-y-1/2 animate-marker rounded-full bg-blue-500'
    >
    </div>
    <div
      class='absolute left-[52%] top-[46%] z-10 h-6 w-6 -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] border-neutral-50 bg-blue-500'
    >
    </div>
  </div>
</div>
